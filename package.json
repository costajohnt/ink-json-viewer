{
  "name": "ink-json-viewer",
  "version": "0.5.1",
  "description": "Interactive, collapsible JSON tree viewer component for Ink",
  "license": "MIT",
  "repository": "github:costajohnt/ink-json-viewer",
  "homepage": "https://github.com/costajohnt/ink-json-viewer#readme",
  "bugs": "https://github.com/costajohnt/ink-json-viewer/issues",
  "author": "John Costa",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "xo",
    "lint:fix": "xo --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ink",
    "cli",
    "json",
    "viewer",
    "tree",
    "terminal",
    "react",
    "tui",
    "inspector"
  ],
  "devDependencies": {
    "@sindresorhus/tsconfig": "^8.1.0",
    "@types/react": "^19.3.0",
    "delay": "^7.0.0",
    "eslint-config-xo-react": "^0.32.0",
    "ink": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.5",
    "xo": "^5.0.1"
  },
  "peerDependencies": {
    "ink": ">=6.0.0",
    "react": ">=19.0.0"
  }
}
